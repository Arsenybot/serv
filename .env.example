# GitHub Configuration
# Personal Access Token with repo & admin:repo_hook permissions
GITHUB_TOKEN=
# Webhook secret shared between GitHub Webhook configuration and LocalPaaS
GITHUB_WEBHOOK_SECRET=

# Database Configuration (PostgreSQL)
POSTGRES_USER=paas
POSTGRES_PASSWORD=paas_secure_password_replace_in_prod
POSTGRES_DB=paas
DATABASE_URL=postgresql://paas:paas_secure_password_replace_in_prod@postgres:5432/paas?schema=public

# Redis Configuration (BullMQ Queue)
REDIS_URL=redis://redis:6379

# Encryption & Security
JWT_SECRET=paas_encryption_key_min_32_characters_random
ENCRYPTION_KEY=super_secret_aes256_encryption_key_32_bytes_long

# Reverse Proxy & Domains
# Default domain for projects: e.g., 'localhost' or 'apps.yourdomain.com'
TRAEFIK_DOMAIN=localhost

# Optional Cloudflare Tunnel Token for public access through Traefik
CLOUDFLARE_TUNNEL_TOKEN=

# Default Resource Limits for deployed containers
DEFAULT_CPU_LIMIT=1
DEFAULT_MEMORY_LIMIT=512m

# Retention & Cleanup
MAX_DEPLOYMENTS_PER_PROJECT=10

# Server Environment
NODE_ENV=production
PORT=3000
